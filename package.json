{
  "name": "poc-be-federated-sdd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "contract:generate": "npm run build && node dist/generate-openapi.js",
    "test": "npm run build && node --test",
    "test:api": "npm run build && node --test tests/health.api.test.js",
    "test:con": "npm run build && node --test tests/health.con.test.js",
    "test:con:gen": "npm run build && node scripts/run-schemathesis.js",
    "test:contract": "npm run test:con && npm run test:con:gen"
  },
  "dependencies": {
    "@fastify/swagger": "^9.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
